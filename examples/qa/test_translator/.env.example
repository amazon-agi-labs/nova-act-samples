# QA Test Translator Configuration
# This file contains all settings for both test execution and Gherkin translation

# ============================================================================
# Test Execution Settings
# ============================================================================

# Auto-translate features before running tests
# Set to 'true' to automatically translate .feature files to JSON before test execution
# Set to 'false' to use existing translated JSON files
# Default: false
TRANSLATE_FEATURES=false

# Workflow Definition Name (optional, defaults to nova-act-examples)
# Name of the workflow definition in Nova Act AWS service
# Auto-discovered or created on first run if it doesn't exist
# NOVA_ACT_WORKFLOW_DEFINITION_NAME=qa-test-runner

# Nova Act Model ID
# Which Nova Act model to use: nova-act-latest or nova-act-preview
# Default: nova-act-latest
# NOVA_ACT_MODEL_ID=nova-act-latest

# Nova Act S3 Bucket Name (optional)
# S3 bucket for workflow export logs. If not set, defaults to
# nova-act-workflow-logs-{account_id}-{region} and is auto-created
# NOVA_ACT_S3_BUCKET_NAME=my-custom-bucket

# Headless Mode
# Set to 'true' to run browser in headless mode (no visible window)
# Set to 'false' to show browser window during test execution
HEADLESS=false

# ============================================================================
# Translation Settings
# ============================================================================

# Bedrock Model ID to use with Strands agents for test translation
# Default: Strands default
# BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Feature Directory
# Directory containing .feature files to translate
# Can be absolute or relative to project root
FEATURE_DIR=features

# Translated Feature Directory
# Directory for translated JSON test files
# Can be absolute or relative to project root
TRANSLATED_FEATURE_DIR=features_translated

# Extracted Variables Directory
# Directory for storing extracted variable JSON files after test execution
# Can be absolute or relative to project root
EXTRACTED_VARIABLES_DIR=extracted_variables

# Custom Functions File
# Path to Python file containing custom test functions
# Can be absolute or relative to project root
# Future: Will support directory path for multi-file projects
CUSTOM_FUNCTIONS_FILE=custom_functions_sample.py

# Default URL (optional)
# Used when a feature has no matching tag mapping
DEFAULT_TEST_URL=https://nova.amazon.com/act/gym/next-dot/

# ============================================================================
# Video Recording Settings
# ============================================================================

# Enable video recording of test executions
# Set to 'true' to record browser sessions, 'false' to disable
ENABLE_VIDEO_RECORDING=false

# Directory to store video recordings
# Can be absolute or relative to project root
VIDEO_RECORDING_DIR=./recordings

# ============================================================================
# Tag-to-URL Mappings
# ============================================================================
# Format: GHERKIN_TAG_<tag_name>=<url>
# These map Gherkin feature tags to base URLs for Nova Act navigation

# Example mappings:
GHERKIN_TAG_nextdotgym=https://nova.amazon.com/act/gym/next-dot/
GHERKIN_TAG_login=https://example.com/login
GHERKIN_TAG_dashboard=https://example.com/dashboard
GHERKIN_TAG_checkout=https://example.com/checkout
GHERKIN_TAG_search=https://example.com/search

